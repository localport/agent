; SELinux policy module "localport" for the targeted policy (Fedora, RHEL 8+).
; Installed by the localport-selinux rpm: semodule -X 200 -i localport.cil.
;
; localport_t           the network agent (localport-device.service, user localport)
; localport_session_t   localport-session: the launcher daemon and the per-session
;                       helper (PAM, identity change, pty, utmp, user transition)
; localport_etc_t       the device dir /etc/localport-device (root-owned config)
; localport_state_t     the identity dir /etc/localport-device/identity (agent state)
; localport_lock_t      /etc/localport-device/run.lock, the one file there the agent
;                       locks and writes
; localport_var_run_t   /run/localport (the launcher socket)
;
; The agent domain has no transition rights and no access to user domains; only
; localport_session_t enters a user's domain, through pam_selinux, the way
; sshd_t does.

(type localport_t)
(type localport_exec_t)
(type localport_session_t)
(type localport_session_exec_t)
(type localport_etc_t)
(type localport_state_t)
(type localport_lock_t)
(type localport_var_run_t)

(roletype system_r localport_t)
(roletype system_r localport_session_t)
(roletype object_r localport_exec_t)
(roletype object_r localport_session_exec_t)
(roletype object_r localport_etc_t)
(roletype object_r localport_state_t)
(roletype object_r localport_lock_t)
(roletype object_r localport_var_run_t)

(typeattributeset domain (localport_t localport_session_t))
(typeattributeset daemon (localport_t localport_session_t))
(typeattributeset nsswitch_domain (localport_t localport_session_t))
(typeattributeset file_type (localport_exec_t localport_session_exec_t localport_etc_t localport_state_t localport_lock_t localport_var_run_t))
(typeattributeset non_security_file_type (localport_exec_t localport_session_exec_t localport_etc_t localport_state_t localport_lock_t localport_var_run_t))
(typeattributeset non_auth_file_type (localport_exec_t localport_session_exec_t localport_etc_t localport_state_t localport_lock_t localport_var_run_t))
(typeattributeset exec_type (localport_exec_t localport_session_exec_t))
(typeattributeset entry_type (localport_exec_t localport_session_exec_t))
(typeattributeset configfile (localport_etc_t))
(typeattributeset pidfile (localport_var_run_t))

; File contexts. The agent binary is installed by packages (/usr/bin), by the
; install script (/usr/local/bin) or under /opt/localport/bin; localport-session
; sits beside it.
(filecon "/usr/bin/localport" file (system_u object_r localport_exec_t ((s0) (s0))))
(filecon "/usr/local/bin/localport" file (system_u object_r localport_exec_t ((s0) (s0))))
(filecon "/opt/localport/bin/localport" file (system_u object_r localport_exec_t ((s0) (s0))))
(filecon "/usr/bin/localport-session" file (system_u object_r localport_session_exec_t ((s0) (s0))))
(filecon "/usr/local/bin/localport-session" file (system_u object_r localport_session_exec_t ((s0) (s0))))
(filecon "/opt/localport/bin/localport-session" file (system_u object_r localport_session_exec_t ((s0) (s0))))
(filecon "/etc/localport-device(/.*)?" any (system_u object_r localport_etc_t ((s0) (s0))))
(filecon "/etc/localport-device/identity(/.*)?" any (system_u object_r localport_state_t ((s0) (s0))))
(filecon "/etc/localport-device/run\.lock" file (system_u object_r localport_lock_t ((s0) (s0))))

; File contexts apply on relabel only. Root creates the device dir, identity/
; and run.lock at run time (connect, service install), so a named transition
; for each admin domain gives them their type at creation, as the
; distribution's own *_filetrans_named_content interfaces do. Files inside
; take the type of their directory.
(macro localport_filetrans_named_content ((type creator))
	(typetransition creator etc_t dir "localport-device" localport_etc_t)
	(typetransition creator localport_etc_t dir "identity" localport_state_t)
	(typetransition creator localport_etc_t file "run.lock" localport_lock_t))
(call localport_filetrans_named_content (unconfined_t))
(call localport_filetrans_named_content (sysadm_t))
(filecon "/run/localport(/.*)?" any (system_u object_r localport_var_run_t ((s0) (s0))))
(filecon "/var/run/localport(/.*)?" any (system_u object_r localport_var_run_t ((s0) (s0))))

;; Service start by systemd (init_daemon_domain).

(typetransition init_t localport_exec_t process localport_t)
(typetransition init_t localport_session_exec_t process localport_session_t)
; The helper enters user domains whose range spans every category, so the
; launcher runs with the full range, as sshd does.
(rangetransition init_t localport_session_exec_t process ((s0) (s0 (range c0 c1023))))
(allow init_t localport_exec_t (file (getattr open read execute map)))
(allow init_t localport_session_exec_t (file (getattr open read execute map)))
(allow init_t localport_t (process (transition siginh rlimitinh noatsecure signal sigkill signull)))
(allow init_t localport_session_t (process (transition siginh rlimitinh noatsecure signal sigkill signull)))
(allow localport_t localport_exec_t (file (entrypoint getattr open read execute map)))
(allow localport_session_t localport_session_exec_t (file (entrypoint getattr open read execute execute_no_trans map)))
(allow localport_t init_t (fd (use)))
(allow localport_session_t init_t (fd (use)))
(allow localport_t init_t (process (sigchld)))
(allow localport_session_t init_t (process (sigchld)))
(allow localport_t init_t (unix_stream_socket (getattr read write ioctl)))
(allow localport_session_t init_t (unix_stream_socket (getattr read write ioctl)))
; systemd creates /run/localport and the socket-activated listener.
(allow init_t localport_var_run_t (dir (create getattr setattr search read open write add_name remove_name rmdir relabelfrom relabelto)))
(allow init_t localport_var_run_t (sock_file (create getattr setattr unlink write relabelfrom relabelto)))
(allow init_t localport_session_t (unix_stream_socket (create bind listen accept getattr setattr getopt setopt read write)))
(allow init_t localport_etc_t (dir (search getattr)))

;; Rules both domains need.

(allow localport_t self (process (fork sigchld signal signull getsched)))
(allow localport_session_t self (process (fork sigchld signal sigkill signull getsched setsched getpgid setpgid getsession getcap setcap setrlimit setexec setkeycreate setsockcreate)))
(allow localport_t self (fifo_file (getattr read write open ioctl)))
(allow localport_session_t self (fifo_file (getattr read write open ioctl)))
(allow localport_t self (unix_stream_socket (create connect getattr getopt setopt read write shutdown)))
(allow localport_t self (unix_dgram_socket (create connect getattr getopt setopt read write)))
(allow localport_session_t self (unix_stream_socket (create bind listen accept connect getattr getopt setopt read write shutdown)))
(allow localport_session_t self (unix_dgram_socket (create connect getattr getopt setopt read write)))
(allow localport_t etc_t (dir (getattr search read open)))
(allow localport_t etc_t (file (getattr read open map)))
(allow localport_t etc_t (lnk_file (getattr read)))
(allow localport_session_t etc_t (dir (getattr search read open)))
(allow localport_session_t etc_t (file (getattr read open map)))
(allow localport_session_t etc_t (lnk_file (getattr read)))
(allow localport_t proc_t (dir (getattr search)))
(allow localport_t proc_t (file (getattr read open)))
(allow localport_session_t proc_t (dir (getattr search)))
(allow localport_session_t proc_t (file (getattr read open)))
(allow localport_t sysfs_t (dir (getattr search)))
(allow localport_t sysfs_t (file (getattr read open)))
(allow localport_session_t sysfs_t (dir (getattr search)))
(allow localport_session_t sysfs_t (file (getattr read open)))
(allow localport_t self (dir (getattr search)))
(allow localport_t self (file (getattr read open)))
(allow localport_t self (lnk_file (getattr read)))
(allow localport_session_t self (dir (getattr search)))
(allow localport_session_t self (lnk_file (getattr read)))
(allow localport_t var_run_t (dir (getattr search)))
(allow localport_session_t var_run_t (dir (getattr search)))
(allow localport_t devlog_t (sock_file (write getattr)))
(allow localport_session_t devlog_t (sock_file (write getattr)))
(allow localport_t localport_etc_t (dir (getattr search read open)))
(allow localport_t localport_etc_t (file (getattr read open)))
(allow localport_session_t localport_etc_t (dir (getattr search read open)))
(allow localport_session_t localport_etc_t (file (getattr read open)))

;; localport_t: the agent.

; Outbound connections to the edge and to local tunnel and desktop targets on
; any port; DNS comes with nsswitch_domain.
(allow localport_t self (tcp_socket (create connect getattr setattr getopt setopt read write shutdown bind)))
(allow localport_t self (udp_socket (create connect getattr setattr getopt setopt read write shutdown bind)))
(allow localport_t self (netlink_route_socket (create bind getattr getopt setopt read write nlmsg_read)))
(allow localport_t port_type (tcp_socket (name_connect)))
(allow localport_t node_type (tcp_socket (node_bind)))
(allow localport_t node_type (udp_socket (node_bind)))
(allow localport_t cert_t (dir (getattr search read open)))
(allow localport_t cert_t (file (getattr read open map)))
(allow localport_t cert_t (lnk_file (getattr read)))
(allow localport_t sysctl_t (dir (search)))
(allow localport_t sysctl_net_t (dir (search)))
(allow localport_t sysctl_net_t (file (getattr read open)))
; The agent's own state: credentials, keys, sessions lock, recording spool.
(allow localport_t localport_state_t (dir (create getattr setattr search read open write add_name remove_name rename rmdir)))
(allow localport_t localport_state_t (file (create getattr setattr read write open append lock rename unlink map)))
; run.lock: the agent opens the existing file, locks it and records its PID
; (truncate and write); root creates it.
(allow localport_t localport_lock_t (file (getattr open read write lock)))
; Requests to the launcher; the session channel fd passes over the connection.
(allow localport_t localport_var_run_t (dir (getattr search)))
(allow localport_t localport_var_run_t (sock_file (getattr write)))
(allow localport_t localport_session_t (unix_stream_socket (connectto)))

;; localport_session_t: launcher and helper.

(allow localport_session_t self (capability (chown dac_override dac_read_search fowner fsetid kill setgid setuid sys_resource sys_tty_config audit_control audit_write)))
(allow localport_session_t self (netlink_audit_socket (create bind connect getattr getopt setopt read write nlmsg_read nlmsg_relay)))
; pam_loginuid writes /proc/self/loginuid.
(allow localport_session_t self (file (getattr read write open)))
(allow localport_session_t self (key (create write search link view read setattr)))
; The agent's socketpair end arrives over SCM_RIGHTS and becomes the helper's fd 3.
(allow localport_session_t localport_t (fd (use)))
(allow localport_session_t localport_t (unix_stream_socket (getattr getopt read write shutdown)))
(allow localport_session_t localport_t (process (signull)))
(allow localport_session_t localport_var_run_t (dir (getattr search read open write add_name remove_name)))
(allow localport_session_t localport_var_run_t (sock_file (create getattr setattr unlink write)))
; PAM: account and session modules, SELinux user context computation.
(allow localport_session_t shadow_t (file (getattr read open)))
(allow localport_session_t security_t (dir (getattr search read open)))
(allow localport_session_t security_t (file (getattr read write open map)))
(allow localport_session_t security_t (security (check_context compute_av compute_create compute_relabel compute_user)))
(allow localport_session_t selinux_config_t (dir (getattr search read open)))
(allow localport_session_t selinux_config_t (file (getattr read open map)))
(allow localport_session_t default_context_t (dir (getattr search read open)))
(allow localport_session_t default_context_t (file (getattr read open map)))
(allow localport_session_t file_context_t (dir (getattr search read open)))
(allow localport_session_t file_context_t (file (getattr read open map)))
; pam_systemd registers the session with logind over the system bus.
(allow localport_session_t system_dbusd_var_run_t (dir (getattr search)))
(allow localport_session_t system_dbusd_var_run_t (sock_file (getattr write)))
(allow localport_session_t system_dbusd_t (unix_stream_socket (connectto)))
(allow localport_session_t system_dbusd_t (dbus (send_msg)))
(allow localport_session_t systemd_logind_t (dbus (send_msg)))
(allow systemd_logind_t localport_session_t (dbus (send_msg)))
(allow system_dbusd_t localport_session_t (dbus (send_msg)))
(allow systemd_logind_t localport_session_t (dir (getattr search)))
(allow systemd_logind_t localport_session_t (file (getattr read open)))
(allow systemd_logind_t localport_session_t (process (getattr)))
(allow localport_session_t systemd_logind_t (fd (use)))
(allow localport_session_t systemd_logind_sessions_t (fifo_file (getattr write)))
; utmp, wtmp, lastlog.
(allow localport_session_t initrc_var_run_t (file (getattr read write open lock)))
(allow localport_session_t var_log_t (dir (getattr search)))
(allow localport_session_t wtmp_t (file (getattr read write open append lock)))
(allow localport_session_t lastlog_t (file (getattr read write open lock)))
; The user's home directory (chdir before exec).
(allow localport_session_t home_root_t (dir (getattr search)))
(allow localport_session_t user_home_dir_t (dir (getattr search)))
; Terminals: open a pty from /dev/ptmx and relabel it to the user's pty type.
(allow localport_session_t devpts_t (dir (getattr search read open)))
(allow localport_session_t devpts_t (chr_file (getattr setattr read write open ioctl relabelfrom)))
(allow localport_session_t ptmx_t (chr_file (getattr read write open ioctl)))
(allow localport_session_t ptynode (chr_file (getattr setattr read write open ioctl relabelfrom relabelto)))
(allow localport_session_t devpts_t (filesystem (getattr)))

; Entering the user's domain: setexeccon from pam_selinux, then exec of the
; login shell (as sshd_t: userdom_spec_domtrans_unpriv_users and
; unconfined_shell_domtrans).
(typeattributeset can_change_process_identity (localport_session_t))
(typeattributeset can_change_process_role (localport_session_t))
(typeattributeset can_change_object_identity (localport_session_t))
(typeattributeset mcssetcats (localport_session_t))
(allow localport_session_t bin_t (dir (getattr search read open)))
(allow localport_session_t bin_t (lnk_file (getattr read)))
(allow localport_session_t shell_exec_t (file (getattr read open execute map)))
(allow localport_session_t unpriv_userdomain (process (transition signal sigkill signull)))
(allow localport_session_t unconfined_t (process (transition signal sigkill signull)))
(allow unpriv_userdomain localport_session_t (fd (use)))
(allow unpriv_userdomain localport_session_t (process (sigchld)))
(allow unconfined_t localport_session_t (fd (use)))
(allow unconfined_t localport_session_t (process (sigchld)))
